# Copy this file to evolution/.env and replace every placeholder before starting Docker Compose.

# Database used only by Evolution API (not the Laravel application database)
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
EVOLUTION_DB_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Evolution API application settings. Confirm the exact keys against the Evolution API image version you deploy.
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

DATABASE_ENABLED=true
DATABASE_PROVIDER=mysql
DATABASE_CONNECTION_URI=mysql://evolution:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@mysql:3306/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6

# Required by Evolution API to protect instance and manager operations.
AUTHENTICATION_API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_API_KEY
