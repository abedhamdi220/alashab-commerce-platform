# Application
APP_NAME="Alashab Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Laravel database and asynchronous processing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alashab
DB_USERNAME=alashab
DB_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb

# Laravel Reverb / broadcasting
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Merchant integrations configuration expected by the source
MERCHANT_DEFAULT_COUNTRY_CODE=963
META_VERIFY_TOKEN=CHANGE_ME_WITH_A_RANDOM_VERIFY_TOKEN
META_APP_SECRET=CHANGE_ME_WITH_META_APP_SECRET
META_WHATSAPP_ACCESS_TOKEN=
MESSENGER_ACCESS_TOKEN=

EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=CHANGE_ME_WITH_EVOLUTION_API_KEY
EVOLUTION_WEBHOOK_URL=https://your-public-domain.example/api/webhook/evolution
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
EVOLUTION_WEBHOOK_HEADER=X-Evolution-Webhook-Secret

# Model-activity configuration expected by the source
MODEL_ACTIVITY_ENABLED=true
MODEL_ACTIVITY_LEVEL=info
MODEL_ACTIVITY_DAYS=90
MODEL_ACTIVITY_INCLUDE_IP=false
MODEL_ACTIVITY_EXCLUDED_ATTRIBUTES=password,remember_token,whatsapp_access_token,messenger_access_token

# Vite public build-time configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/stores/your-store-slug
VITE_STORE_SLUG=your-store-slug
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000
VITE_REVERB_APP_KEY=CHANGE_ME
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
