# Laravel runtime and secrets
.env
.env.*
!.env.example
/storage/*.key
/storage/logs/
storage/framework/
bootstrap/cache/
public/storage
vendor/

# Frontend dependencies and build outputs
node_modules/
dist/
public/build/
coverage/
.vite/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local Evolution API state and generated QR/session files
evolution/.env
evolution/data/
evolution/instances/

# Uploaded media and temporary files
public/uploads/
public/media/
*.log

# Exclude local SQLite runtime state; migrations are versioned instead.
database/*.sqlite

# Generated Laravel cache files
bootstrap/cache/*.php
!bootstrap/cache/.gitignore
